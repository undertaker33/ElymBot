    <string name="elym_faq_setup_question">How do I set up ElymBot?</string>
    <string name="elym_faq_setup_answer">Open First-time setup, add a model service, and select a text chat model. Verify tool calling, then create or activate a persona for the main conversation to start chatting.</string>
    <string name="elym_faq_models_question">Where do I switch chat models?</string>
    <string name="elym_faq_models_answer">Open Configuration from the bottom bar. Under Models, open Text chat, select a model from a service and save.</string>
    <string name="elym_faq_open_models">Open model settings</string>
    <string name="elym_faq_plugins_question">Where can I manage installed plugins?</string>
    <string name="elym_faq_plugins_answer">Switch to Installed on the Plugins page to see versions and which plugins are enabled.</string>
    <string name="elym_faq_qq_question">Where do I set up QQ?</string>
    <string name="elym_faq_qq_answer">Open QQ from the Platforms page, tap Start, and scan the QR code when it appears.</string>
    <string name="elym_faq_tasks_question">Where do I create scheduled tasks?</string>
    <string name="elym_faq_tasks_answer">Open the menu in the main app conversation and choose Scheduled tasks.</string>
